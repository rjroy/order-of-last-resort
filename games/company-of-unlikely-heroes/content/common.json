  "behaviors": {
    "sing_melody": {
      "handler": "use_ability",
      "params": {"ability": "inspiring_melody"}
    },
    "sing_sonnet": {
      "handler": "use_ability",
      "params": {"ability": "healing_sonnet"}
    },
    "skeleton_greetings": {
      "handler": "greet",
      "params": {"team": "enemies", "move_ability": "move", "greeting_range": 1, "greetings": ["wave", "dont_go"]}
    },
    "zombie_greetings": {
      "handler": "greet",
      "params": {"team": "enemies", "move_ability": "move", "greeting_range": 2, "greetings": ["say_hello", "offer_flower"]}
    },
    "retreat": {
      "handler": "retreat",
      "params": {"move_ability": "move", "team": "enemies"}
    },
    "guard": {
      "handler": "use_ability",
      "params": {
        "ability": "knight_aura"
      }
    },
    "advance": {
      "handler": "pursue",
      "params": {
        "ability": "knight_push",
        "move_ability": "move",
        "team": "enemies"
      }
    },
    "support": {
      "handler": "use_ability",
      "params": {
        "ability": "healer_heal"
      }
    },
    "aggressive": {
      "handler": "pursue",
      "params": {
        "ability": "healer_bonk",
        "move_ability": "move",
        "team": "enemies"
      }
    },
