      "params": {"ability": "alchemist_acid"}
    },
    "harpooner": {
      "handler": "threat",
      "params": {
        "ability": "enemy_harpoon",
        "move_ability": "move",
        "pursue_range": 5,
        "fallback_teams": [
          "heroes",
          "civilian"
        ],
        "taunt_status": "taunt"
      }
    },
    "escort": {
      "handler": "escort",
      "params": {
        "move_ability": "move"
      }
    }
  },
