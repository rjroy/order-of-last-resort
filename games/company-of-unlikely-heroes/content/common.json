  "abilities": {
    "inspiring_melody": {
      "label": "Inspiring Melody",
      "help": "A random eligible opponent skips its next turn laughing, then is immune to laughter through the following round.",
      "handler": "perform",
      "params": {"status": "laughter", "listener_event": "melody_listener"},
      "targeting": {"kind": "automatic", "teams": ["enemies"]}
    },
    "healing_sonnet": {
      "label": "Healing Sonnet",
      "help": "Deals 1 damage to a random living opponent. Despite the name, nobody is healed.",
      "handler": "perform",
      "params": {"damage": 1, "listener_event": "sonnet_listener"},
      "targeting": {"kind": "automatic", "teams": ["enemies"]}
    },
    "raise_dead": {
      "label": "Raise Dead",
      "help": "Choose an unoccupied enemy corpse. It becomes a zombie with half the enemy's maximum HP, rounded up.",
      "handler": "summon",
      "params": {"character": "zombie", "priority": 1},
      "targeting": {"kind": "entity", "teams": ["enemies"]}
    },
    "summon_skeleton": {
      "label": "Summon Skeleton",
      "help": "Choose an open neighboring tile for a 1 HP skeleton. It first acts next round.",
      "handler": "summon",
      "params": {"character": "skeleton", "priority": 0},
      "targeting": {"kind": "cell", "range": 1}
    },
    "wave": {
      "label": "Wave",
      "help": "Requires a nearby opponent. Deals 1 damage to every other living character next to the skeleton, friend or foe.",
      "handler": "sweep",
      "params": {"damage": 1, "opponents_only": true},
      "targeting": {"kind": "none", "range": 1}
    },
    "dont_go": {
      "label": "Don't Go",
      "help": "The closest eligible opponent cannot use Move on their next turn.",
      "handler": "stop_target",
      "params": {"status": "held_in_place", "opponents_only": true},
      "targeting": {"kind": "automatic"}
    },
    "say_hello": {
      "label": "Say Hello",
      "help": "The closest opponent steps one tile back if that tile is open.",
      "handler": "repel",
      "params": {"opponents_only": true},
      "targeting": {"kind": "automatic"}
    },
    "offer_flower": {
      "label": "Offer Flower",
      "help": "Offer a flower tied to a rock. Deals 1 damage to an opponent up to two tiles away.",
      "handler": "attack",
      "params": {"damage": 1, "source_suffix": "'s Offer Flower", "opponents_only": true},
      "targeting": {"kind": "entity", "range": 2, "teams": ["enemies"]}
    },
    "rogue_confusing_dodge": {
      "label": "Confusing Dodge",
      "help": "Swap with the furthest other living character, friend or foe. Distance ties go to the lowest character ID.",
      "handler": "swap_furthest",
      "params": {},
      "targeting": {"kind": "automatic"}
    },
    "rogue_wasnt_me": {
      "label": "Wasn't Me",
      "help": "Choose an enemy beside another living character. Its next attack redirects to an adjacent character other than its original target, lowest ID first. If none exists, the attack proceeds normally.",
      "handler": "misdirect",
      "params": {"status": "misdirected"},
      "targeting": {"kind": "entity", "teams": ["enemies"]}
    },
    "move": {
      "label": "Move one tile",
      "help": "Step to an open neighboring tile.",
      "handler": "move",
      "params": {},
      "targeting": {
        "kind": "cell",
        "range": 1
      }
    },
    "knight_push": {
      "label": "Push",
      "help": "Push a neighboring unit or obstacle one tile. Collision deals damage.",
      "handler": "push",
      "params": {
        "collision_damage": 2
      },
      "targeting": {
        "kind": "entity",
        "range": 1,
        "objects": true,
        "capabilities": [
          "pushable"
        ]
      }
    },
    "knight_aura": {
      "label": "Reflecting aura",
      "help": "Covers everyone within one tile; reflects to the nearest enemy or obstacle.",
      "handler": "apply_status",
      "params": {
        "status": "aura"
      },
      "targeting": {
        "kind": "none"
      }
    },
    "healer_bonk": {
      "label": "Bonk and taunt",
      "help": "Bonk an adjacent enemy or obstacle. Taunts enemies into targeting the user.",
      "handler": "bonk",
      "params": {
        "damage": 2,
        "status": "taunt"
      },
      "targeting": {
        "kind": "entity",
        "range": 1,
        "teams": [
          "enemies"
        ],
        "objects": true,
        "capabilities": [
          "damageable"
        ]
      }
    },
    "healer_heal": {
      "label": "Heal self or nearest ally",
      "help": "Heals self when wounded; otherwise heals the nearest other hero, even at full health.",
      "handler": "heal",
      "params": {
        "amount": 3,
        "prefer_wounded_self": true
      },
      "targeting": {
        "kind": "automatic",
        "teams": [
          "heroes"
        ],
        "capabilities": [
          "healable"
        ]
      }
    },
    "wizard_blast": {
      "label": "Blast nearest",
      "help": "Hits and knocks down the nearest unit, friend or foe. Obstacles can take the hit.",
      "handler": "blast",
      "params": {
        "damage": 4,
        "status": "knockdown"
      },
      "targeting": {
        "kind": "automatic",
        "objects": true,
        "capabilities": [
          "damageable"
        ]
      }
    },
    "alchemist_potion": {
      "label": "Healing Potion",
      "help": "Heal yourself or a friendly character within reach. The forecast shows the exact reaction (70% beneficial, 20% harmful, 10% cosmetic).",
      "handler": "healing_potion",
      "params": {"amount": 1},
      "targeting": {"kind": "entity", "range": 1}
    },
    "alchemist_acid": {
      "label": "Acid",
      "help": "Damage a hostile character within reach. The forecast shows the exact reaction (70% harmful, 20% beneficial, 10% cosmetic).",
      "handler": "acid",
      "params": {"damage": 1},
      "targeting": {"kind": "entity", "range": 3}
    },
    "wizard_pull": {
      "label": "Pull and recoil",
      "help": "Pull a target onto your tile. Recoil hurts and knocks you down.",
      "handler": "pull",
      "params": {
        "recoil_damage": 2,
        "status": "knockdown"
      },
      "targeting": {
        "kind": "entity",
        "capabilities": [
          "pullable"
        ]
      }
    },
    "enemy_attack": {
      "label": "Attack",
      "help": "Attack an adjacent target.",
      "handler": "attack",
      "params": {
        "damage": 2,
        "source_suffix": ""
      },
      "targeting": {
        "kind": "entity",
        "range": 1,
        "objects": true,
        "capabilities": [
          "damageable"
        ]
      }
    },
    "enemy_harpoon": {
      "label": "Harpoon",
      "help": "Strike a target up to two tiles away.",
      "handler": "attack",
      "params": {
        "damage": 2,
        "source_suffix": "'s harpoon"
      },
      "targeting": {
        "kind": "entity",
        "range": 2,
        "objects": true,
        "capabilities": [
          "damageable"
        ]
      }
    }
  },
