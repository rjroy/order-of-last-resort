    "reflect_redirect": {"text": "{protector}'s aura redirects the attack on {ward} to {target}."},
    "push": {"text": "{actor} pushes {target} to {position}."},
    "collision_suffix": {"text": "'s collision"},
    "aura": {"text": "{actor} raises an aura (range {range}) that redirects incoming damage and attack effects; movement and recoil are unaffected."},
