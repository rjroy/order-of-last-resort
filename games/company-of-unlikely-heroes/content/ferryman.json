  "behaviors": {
    "guard": {"handler": "use_ability", "params": {"ability": "knight_aura"}},
    "advance": {
      "handler": "pursue", "params": {"ability": "knight_push", "move_ability": "move", "team": "enemies"}
    },
    "support": {"handler": "use_ability", "params": {"ability": "healer_heal"}},
    "aggressive": {
      "handler": "pursue", "params": {"ability": "healer_bonk", "move_ability": "move", "team": "enemies"}
    },
    "hold": {"handler": "hold", "params": {}},
    "blast": {"handler": "use_ability", "params": {"ability": "wizard_blast"}},
    "rescue": {"handler": "rescue", "params": {"ability": "wizard_pull"}},
    "harpooner": {
      "handler": "threat",
      "params": {
        "ability": "enemy_harpoon", "move_ability": "move", "pursue_range": 5,
        "fallback_teams": ["heroes", "civilian"], "taunt_status": "taunt"
      }
    },
    "escort": {"handler": "escort", "params": {"move_ability": "move"}}
  },
  "statuses": {
    "aura": {
      "label": "Reflecting aura", "handler": "reflect", "expiry": "actor_turn_start",
      "params": {"range": 1, "teams": ["enemies"], "objects": true}
    },
    "knockdown": {
      "label": "Down", "handler": "skip_action", "expiry": "consume_action", "params": {}
    },
    "taunt": {
      "label": "Taunted", "handler": "retarget", "expiry": "actor_turn_end",
      "params": {"teams": ["heroes"]}
    }
  },
  "events": {
    "move": {"text": "{actor} moves to {position}."},
    "damage": {"text": "{source} deals {amount} damage to {target}{effect}."},
    "knockdown_suffix": {"text": " and knocks them down"},
