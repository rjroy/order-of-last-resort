  "abilities": {
    "move": {
      "label": "Move one tile", "help": "Step to an open neighboring tile.",
      "handler": "move", "params": {}, "targeting": {"kind": "cell", "range": 1}
    },
    "knight_push": {
      "label": "Push", "help": "Push a neighboring unit or obstacle one tile. Collision deals damage.",
      "handler": "push", "params": {"collision_damage": 2},
      "targeting": {"kind": "entity", "range": 1, "objects": true, "capabilities": ["pushable"]}
    },
    "knight_aura": {
      "label": "Reflecting aura",
      "help": "Covers everyone within one tile; reflects to the nearest enemy or obstacle.",
      "handler": "apply_status", "params": {"status": "aura"}, "targeting": {"kind": "none"}
    },
    "healer_bonk": {
      "label": "Bonk and taunt",
      "help": "Hurt an adjacent enemy or obstacle. Enemies also turn their attention to the healer.",
      "handler": "bonk", "params": {"damage": 2, "status": "taunt"},
      "targeting": {"kind": "entity", "range": 1, "teams": ["enemies"], "objects": true,
        "capabilities": ["damageable"]}
    },
    "healer_heal": {
      "label": "Heal nearest ally",
      "help": "Heals the nearest other hero, even if they are already at full health.",
      "handler": "heal", "params": {"amount": 3},
      "targeting": {"kind": "automatic", "teams": ["heroes"], "capabilities": ["healable"]}
    },
    "wizard_blast": {
      "label": "Blast nearest",
      "help": "Hits and knocks down the nearest unit, friend or foe. Obstacles can take the hit.",
      "handler": "blast", "params": {"damage": 4, "status": "knockdown"},
      "targeting": {"kind": "automatic", "objects": true, "capabilities": ["damageable"]}
    },
    "wizard_pull": {
      "label": "Pull and recoil",
      "help": "Draws the target to the wizard’s tile. Recoil hurts and knocks down the wizard.",
      "handler": "pull", "params": {"recoil_damage": 2, "status": "knockdown"},
      "targeting": {"kind": "entity", "capabilities": ["pullable"]}
    },
    "enemy_attack": {
      "label": "Attack", "help": "Attack an adjacent target.",
      "handler": "attack", "params": {"damage": 2, "source_suffix": ""},
      "targeting": {"kind": "entity", "range": 1, "objects": true, "capabilities": ["damageable"]}
    },
    "enemy_harpoon": {
      "label": "Harpoon", "help": "Strike a target up to two tiles away.",
      "handler": "attack", "params": {"damage": 2, "source_suffix": "'s harpoon"},
      "targeting": {"kind": "entity", "range": 2, "objects": true, "capabilities": ["damageable"]}
    }
  },
  "orders": {
    "order_guard": {"label": "Guard"},
    "order_advance": {"label": "Advance"},
    "order_support": {"label": "Support"},
    "order_aggressive": {"label": "Pursue and bonk"},
