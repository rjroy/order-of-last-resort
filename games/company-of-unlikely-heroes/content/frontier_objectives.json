{
  "missions": {
    "great_sheep_escape": {
      "title": "The Great Sheep Escape",
      "encounter": "frontier_sheep_field",
      "default_party": [
        "knight",
        "healer",
        "wizard"
      ],
      "objective": {
        "handler": "herd_sheep",
        "subjects": [
          "sheep_one",
          "sheep_two",
          "sheep_three"
        ],
        "pen": "pen",
        "text": "Get all three living sheep into the east pen together. At round's end, each unpenned sheep flees the nearest non-sheep character within 2 tiles, taking one free step as far away as possible. If no step takes it farther away, it takes a free step closer to the pen, if it can. Equal-distance characters follow initiative order; movement ties favor right, down, left, then up. Penned sheep settle. The shepherd scatters them too.",
        "victory_text": "The entire flock is safely in the pen.",
        "defeat_text": "The flock could not be brought home.",
        "victory_event": "All three sheep are safely in the pen."
      },
      "failures": [
        {
          "handler": "party_wiped",
          "event": "The company has fallen."
        }
      ],
      "tier": 2
    },
    "bridge_is_out": {
      "title": "The Bridge Is Out",
      "encounter": "frontier_bridge",
      "default_party": [
        "knight",
        "healer",
        "wizard"
      ],
      "objective": {
        "handler": "collapsing_bridge",
        "exit": "far_bank",
        "collapses": [
          {
            "round": 4,
            "cells": "first_span"
          },
          {
            "round": 6,
            "cells": "second_span"
          }
        ],
        "text": "Get any living hero to the far bank at G3 by the end of round 8. C2\u2013C4 collapse at the end of round 4; E2\u2013E4 collapse at the end of round 6. Occupants of collapsing tiles are defeated, and fallen sections cannot be crossed. If no hero reaches G3 by round 8, the remaining bridge collapses and the mission is lost. The raider need not be defeated.",
        "victory_text": "A hero reaches the far bank as the bridge comes apart.",
        "defeat_text": "The company did not make the crossing.",
        "victory_event": "A hero reaches the far bank."
      },
      "failures": [
        {
          "handler": "party_wiped",
          "event": "The company has fallen."
        },
        {
          "handler": "deadline",
          "event": "The remaining bridge collapses before a hero reaches the far bank."
        }
      ],
      "tier": 2
    },
    "last_wagon": {
      "title": "The Last Wagon",
      "encounter": "frontier_wagon_road",
      "default_party": [
        "knight",
        "healer",
        "wizard"
      ],
      "objective": {
        "handler": "wagon",
        "subject": "wagon",
        "destination": "village",
        "text": "Protect the supply wagon until it reaches the village at G3. It advances one tile each round when no living enemy is adjacent; an adjacent enemy stalls it. Raiders target the wagon. If it is destroyed or the company falls, the mission is lost.",
        "victory_text": "The wagon and its supplies reach the village.",
        "defeat_text": "The village's last wagon was lost.",
        "victory_event": "The supply wagon reaches the village."
      },
      "failures": [
        {
          "handler": "party_wiped",
          "event": "The company has fallen."
        }
      ],
      "tier": 2
    }
  },
