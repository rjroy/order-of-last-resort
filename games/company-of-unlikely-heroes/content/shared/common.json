  "abilities": {
    "wave": {
      "label": "Wave",
      "help": "Requires a nearby opponent. Deals 1 damage to every other living character next to the skeleton, friend or foe.",
      "handler": "sweep",
      "params": {
        "damage": 1,
        "opponents_only": true
      },
      "targeting": {
        "kind": "none",
        "range": 1
      }
    },
    "dont_go": {
      "label": "Don't Go",
      "help": "The closest eligible opponent cannot use Move on their next turn.",
      "handler": "stop_target",
      "params": {
        "status": "held_in_place",
        "opponents_only": true
      },
      "targeting": {
        "kind": "automatic"
      }
    },
    "say_hello": {
      "label": "Say Hello",
      "help": "The closest opponent steps one tile back if that tile is open.",
      "handler": "repel",
      "params": {
        "opponents_only": true
      },
      "targeting": {
        "kind": "automatic"
      }
    },
    "offer_flower": {
      "label": "Offer Flower",
      "help": "Offer a flower tied to a rock. Deals 1 damage to an opponent up to two tiles away.",
      "handler": "attack",
      "params": {
        "damage": 1,
        "source_suffix": "'s Offer Flower",
        "opponents_only": true
      },
      "targeting": {
        "kind": "entity",
        "range": 2,
        "teams": [
          "enemies"
        ]
      }
    },
    "move": {
      "label": "Move one tile",
      "help": "Step to an open neighboring tile.",
      "handler": "move",
      "params": {},
      "targeting": {
        "kind": "cell",
        "range": 1
      }
    },
    "enemy_attack": {
      "label": "Attack",
      "help": "Attack an adjacent target.",
      "handler": "attack",
      "params": {
        "damage": 2,
        "source_suffix": ""
      },
      "targeting": {
        "kind": "entity",
        "range": 1,
        "objects": true,
        "capabilities": [
          "damageable"
        ]
      }
    },
    "enemy_harpoon": {
      "label": "Harpoon",
      "help": "Strike a target up to two tiles away.",
      "handler": "attack",
      "params": {
        "damage": 2,
        "source_suffix": "'s harpoon"
      },
      "targeting": {
        "kind": "entity",
        "range": 2,
        "objects": true,
        "capabilities": [
          "damageable"
        ]
      }
    }
  },
