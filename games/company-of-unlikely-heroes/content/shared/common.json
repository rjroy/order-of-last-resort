  "events": {
    "follow_ally": {
      "text": "{actor} follows {target} to {position}."
    },
    "performance_dry": {
      "text": "{actor} sings {ability}, but there is no eligible listener."
    },
    "melody_listener": {
      "text": "{actor} sings {ability}. {target} bursts out laughing and will miss their next turn."
    },
    "sonnet_listener": {
      "text": "{actor} sings {ability}. {target} screams in pain and takes {amount} damage."
    },
    "laugh_skip": {
      "text": "{actor} laughs away this turn and is immune to laughter through the next round."
    },
    "summon": {
      "text": "{actor} summons a {minion} at {position} ({hp} HP). It first acts next round."
    },
    "raise": {
      "text": "{actor} raises a {minion} from the {corpse} corpse at {position} ({hp} HP). It first acts next round."
    },
    "sweep": {
      "text": "{actor} uses {ability}, hitting adjacent characters."
    },
    "stop_target": {
      "text": "{actor} uses {ability}. {target} cannot {movement} on their next turn."
    },
    "repel": {
      "text": "{actor} uses {ability}. {target} backs up to {position}."
    },
    "swap": {
      "text": "{actor} swaps places with {target}, arriving at {position}."
    },
    "misdirect_mark": {
      "text": "{actor} misleads {target}. {victim} is currently adjacent; the actual alternate target is chosen when the attack occurs, excluding its original target."
    },
    "misdirect_redirect": {
      "text": "{actor}'s attack is redirected to {target}."
    },
    "misdirect_missing": {
      "text": "{actor} has no adjacent alternate target; the attack against {target} proceeds normally."
    },
    "move": {
      "text": "{actor} moves to {position}."
    },
    "damage": {
      "text": "{source} deals {amount} damage to {target}{effect}."
    },
    "knockdown_suffix": {
      "text": " and knocks them down"
    },
    "reflect_absorb": {
      "text": "{protector}'s aura absorbs the attack on {ward}; no redirect target remains."
    },
    "reflect_redirect": {
      "text": "{protector}'s aura redirects the attack on {ward} to {target}."
    },
    "push": {
      "text": "{actor} pushes {target} to {position}."
    },
    "collision_suffix": {
      "text": "'s collision"
    },
    "aura": {
      "text": "{actor} raises an aura (range {range}) that can redirect incoming attack damage; movement and recoil are unaffected."
    },
    "taunt": {
      "text": "{actor} taunts {target}."
    },
    "heal": {
      "text": "{actor} heals {target} for {amount}."
    },
    "heal_full": {
      "text": "{actor} heals {target} (already at full health)."
    },
    "blast_suffix": {
      "text": "'s blast"
    },
    "pull": {
      "text": "{actor} pulls {target} to {position} and recoils to {recoil}."
    },
    "recoil_source": {
      "text": "Recoil"
    },
    "cannot_advance": {
      "text": "{actor} cannot advance."
    },
    "recover": {
      "text": "{actor} gets up and loses this action."
    },
    "hold": {
      "text": "{actor} holds position."
    },
    "invalid": {
      "text": "{actor}'s action is no longer valid."
    },
    "watches": {
      "text": "{actor} watches for a closer target."
    },
    "gain_status": {
      "text": "{actor} gains {status}."
    }
