        "handler": "defeat_all",
        "text": "Defeat the goblins closing in from both sides. Goblins deal extra damage when two or more crowd the same target.",
        "victory_text": "The mob scatters. The company presses on.",
        "defeat_text": "The mob overwhelms the company.",
        "victory_event": "The last goblin falls."
      },
      "failures": [{"handler": "party_wiped", "event": "The company has fallen."}],
